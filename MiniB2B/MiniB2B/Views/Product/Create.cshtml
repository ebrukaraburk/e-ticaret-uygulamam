@model MiniB2B.Models.Product

@section Styles {
    <link rel="stylesheet" href="~/css/product-form.css" asp-append-version="true" />
}

<div class="product-form-page">
    <div class="product-form-card">

        <div class="product-form-head">
            <h2>Yeni Ürün Ekle</h2>
            <div class="form-sub">Kod, fiyat ve stok bilgilerini eksiksiz girin</div>
        </div>

        <form asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
            <div class="product-form-body">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="form-section">
                    <div class="form-section-title">Ürün Kimliği</div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="ProductCode" class="form-label"></label>
                            <input asp-for="ProductCode" class="form-control" />
                            <span asp-validation-for="ProductCode" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ProductName" class="form-label"></label>
                            <input asp-for="ProductName" class="form-control" />
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Brand" class="form-label"></label>
                            <input asp-for="Brand" class="form-control" />
                            <span asp-validation-for="Brand" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ManufacturerCode" class="form-label"></label>
                            <input asp-for="ManufacturerCode" class="form-control" />
                            <span asp-validation-for="ManufacturerCode" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="SpecialCode1" class="form-label"></label>
                            <input asp-for="SpecialCode1" class="form-control" />
                            <span asp-validation-for="SpecialCode1" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="SpecialCode2" class="form-label"></label>
                            <input asp-for="SpecialCode2" class="form-control" />
                            <span asp-validation-for="SpecialCode2" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-title">Ürün Görseli</div>
                    <div class="image-drop">
                        <div class="image-preview">
                            <i class="bi bi-image placeholder-icon"></i>
                        </div>
                        <div class="image-drop-text">
                            <strong>Görsel seçin ya da buraya sürükleyin</strong>
                            <span class="file-name">Henüz dosya seçilmedi</span>
                        </div>
                        <input type="file" name="resimDosyasi" accept="image/*" />
                    </div>
                </div>

                <div class="form-section">
                    <div class="form-section-title">Açıklama</div>
                    <div class="mb-1">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label"></label>
                    <select asp-for="CategoryId" class="form-select"
                            asp-items="@(new SelectList(ViewBag.Kategoriler as IEnumerable<MiniB2B.Models.Category>, "Id", "Name"))">
                        <option value="">-- Kategori seçin --</option>
                    </select>
                </div>


                <div class="form-section mb-0">
                    <div class="form-section-title">Fiyat ve Stok</div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="UnitPrice" class="form-label"></label>
                            <input asp-for="UnitPrice" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="UnitPrice" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="StockQuantity" class="form-label"></label>
                            <input asp-for="StockQuantity" type="number" class="form-control" />
                            <span asp-validation-for="StockQuantity" class="text-danger"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="CriticalStockQuantity" class="form-label"></label>
                            <input asp-for="CriticalStockQuantity" type="number" class="form-control" />
                        </div>
                    </div>
                </div>

            </div>

            <div class="product-form-actions">
                <a asp-controller="Product" asp-action="Index" class="btn-cancel">İptal</a>
                <button type="submit" class="btn-save">Ürünü kaydet</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/product-form.js" asp-append-version="true"></script>
}