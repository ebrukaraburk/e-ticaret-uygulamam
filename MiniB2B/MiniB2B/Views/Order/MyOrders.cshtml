@model IEnumerable<MiniB2B.Models.Order>

@{
    ViewData["Title"] = "Siparişlerim";
}

<link rel="stylesheet" href="~/css/my-orders.css?v=2" />
<div class="container mt-4 my-orders-page">
    <div class="page-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h2 class="mb-0"><i class="bi bi-box-seam"></i> Siparişlerim</h2>

        @if (Model != null && Model.Any())
        {
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="orderSearch" class="form-control" placeholder="Sipariş numarası ara..." />
            </div>
        }
    </div>
    <hr />

    @if (TempData["Mesaj"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @TempData["Mesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="empty-orders text-center py-5">
            <i class="bi bi-inbox display-1 text-muted"></i>
            <div class="alert alert-warning d-inline-block mt-3">Henüz oluşturulmuş bir siparişiniz bulunmamaktadır.</div>
            <div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-grid"></i> Ürün Kataloğuna Git
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Durum filtre sekmeleri -->
        <div class="status-filters mb-3">
            <button class="filter-btn active" data-filter="all">Tümü</button>
            <button class="filter-btn" data-filter="Onay Bekliyor">Onay Bekliyor</button>
            <button class="filter-btn" data-filter="Onaylandı">Onaylandı</button>
            <button class="filter-btn" data-filter="Hazırlanıyor">Hazırlanıyor</button>
            <button class="filter-btn" data-filter="Araca Yüklendi">Araca Yüklendi</button>
            <button class="filter-btn" data-filter="Kargoya Verildi">Kargoya Verildi</button>
            <button class="filter-btn" data-filter="Yola Çıktı">Yola Çıktı</button>
            <button class="filter-btn" data-filter="Teslim Edildi">Teslim Edildi</button>
            <button class="filter-btn" data-filter="Reddedildi">Reddedildi</button>
            <button class="filter-btn" data-filter="İptal Edildi">İptal Edildi</button>
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="myOrdersTable">
                    <thead class="table-light">
                        <tr>
                            <th>Sipariş Numarası</th>
                            <th>Tarih</th>
                            <th>Toplam Tutar</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr class="order-row" data-status="@order.Status" data-search="@order.OrderNumber.ToString().ToLower()">
                                <td class="fw-bold">@order.OrderNumber</td>
                                <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="text-success fw-bold">@order.TotalAmount.ToString("N2") ₺</td>
                                <td>
                                    <!-- Yönetici tarafından değiştirilen durumun yansıdığı alan -->
                                    <span class="badge bg-@(MiniB2B.Services.OrderService.Renk(order.Status)) fs-6">@order.Status</span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="Order" asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-eye"></i> Detay
                                    </a>
                                    @if (order.Status == "Onay Bekliyor")
                                    {
                                        <form asp-controller="Order" asp-action="CancelOrder" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@order.Id" />
                                            <button type="button" class="btn btn-sm btn-outline-danger js-cancel-confirm"
                                                    data-order-number="@order.OrderNumber">
                                                <i class="bi bi-x-circle"></i> İptal Et
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <p class="text-muted small mt-2" id="rowCountInfo"></p>
    }
</div>

<!-- Sipariş iptal onay modalı -->
<div class="confirm-overlay" id="cancelConfirmOverlay">
    <div class="confirm-box">
        <i class="bi bi-exclamation-triangle display-6 text-danger"></i>
        <p class="mt-2 mb-1" id="cancelConfirmMessage">Emin misiniz?</p>
        <div class="confirm-actions">
            <button type="button" class="btn btn-secondary btn-sm" id="cancelConfirmNo">Vazgeç</button>
            <button type="button" class="btn btn-danger btn-sm" id="cancelConfirmYes">Evet, İptal Et</button>
        </div>
    </div>
</div>
<script src="~/js/my-orders.js?v=2"></script>